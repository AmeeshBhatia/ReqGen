# Copy this file to ".env" (or just paste keys in the app via ⚙).

# Default provider: gemini  or  openrouter
LLM_PROVIDER=gemini

# --- Google Gemini (free, huge context) — https://aistudio.google.com/apikey ---
GEMINI_API_KEY=paste_your_key_here
GEMINI_MODEL=gemini-2.0-flash-lite

# --- OpenRouter (free tier ~50 req/day) — https://openrouter.ai/keys ---
# Use models whose ID ends with :free
OPENROUTER_API_KEY=paste_your_openrouter_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

PORT=4545
